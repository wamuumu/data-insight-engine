# --- DOCKER CONFIGURATION ---
PROJECT_NAME=ingestion-service
NETWORK_NAME=dairnet

# --- APP CONFIGURATION ---
APP_IMAGE=data-insight-engine
MOUNTS_FILE=mounts.yaml

# --- POSTGRES CONFIGURATION ---
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_NAME=your_postgres_db
DB_URL=postgresql://your_postgres_user:your_postgres_password@postgres:5432/your_postgres_db
DB_BATCH_SIZE=500

# --- PARSING CONFIGURATION ---
PARQUET_BATCH_SIZE=500

# --- INGESTION CONFIGURATION ---
WORKERS=4
DB_RETRY_ATTEMPTS=4
DB_RETRY_INITIAL_DELAY=0.5
DB_RETRY_MAX_DELAY=8.0
FILE_RETRY_TIMEOUT=300
MAX_BATCH_SPLIT_DEPTH=10

# --- SCHEDULER CONFIGURATION ---
DATA_ROOT=data

# --- MONITORING CONFIGURATION ---
METRICS_PORT=8000

# --- GRAFANA CONFIGURATION ---
GRAFANA_USER=your_grafana_user
GRAFANA_PASSWORD=your_grafana_password

# --- LOGGING CONFIGURATION ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# One of: console, json
LOG_FORMAT=console